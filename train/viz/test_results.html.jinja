<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width"/>
        <title>Incorrect test results</title>
        <link rel="stylesheet" type="text/css" href="./train/viz/test_results.css"/>
        <script src="./train/viz/test_results.js"></script>
    </head>
    <body>
        <h1>Incorrect sentences in test data</h1>
        <h2>{{ sentences|length }} incorrect sentences.</h2>
        <details>
            <summary>
                <h4>Filter by number of mismatches, source and label error.<span id="filter-counts"></span></h4>
            </summary>
            <div class="filters">
                <div class="filter-options">
                    <h5>Number of errors</h5>
                    <button type="button" class="select-all">Select all</button>
                    {%- for count in error_counts -%}
                    <label for="filter-{{ count }}">{{ count }}
                        <input type="checkbox" class="mismatch" name="filter-{{ count }}" id="filter-{{ count }}" data-value="{{ count }}">
                    </label>
                    {%- endfor -%}
                </div>
                <div class="filter-options">
                    <h5>Source</h5>
                    <button type="button" class="select-all">Select all</button>
                    {%- for source, count, percent in error_source -%}
                    <label for="filter-{{ source }}">{{ source }} ({{ count }} = {{ "%.1f"|format(percent) }}%)
                        <input type="checkbox" class="src" name="filter-{{ source }}" id="filter-{{ source }}" data-value="{{ source }}">
                    </label>
                    {%- endfor -%}
                </div>
                <div class="filter-options">
                    <h5>Label error</h5>
                    <button type="button" class="select-all">Select all</button>
                    {%- for label, count in error_label -%}
                    <label for="filter-{{ label }}">{{ label }} ({{ count }})
                        <input type="checkbox" class="error" name="filter-{{ label }}" id="filter-{{ label }}" data-value="{{ label }}">
                    </label>
                    {%- endfor -%}
                </div>
                <div class="filter-options">
                    <h5>Filter by token</h5>
                    <input type="search" id="token-filter" name="token-filter">
                    <button type="button" class="select-all">Filter by tokens</button>
                </div>
            </div>
        </details>
        {%- for sentence in sentences -%}
        <div class="wrapper hidden" data-mismatches="{{ sentence.mismatch_count }}" data-src="{{ sentence.source }}" data-errors="{{ sentence.label_errors|join(",") }}">
            <div>
                <p>[{{ sentence.source|upper }}] {{ sentence.sentence }}</p>
                <button class="copy">Copy text</button>
            </div>
            <table>
                <tr>
                    <td class="row-title">Token</td>
                    {%- for token in sentence.tokens -%}
                    <td>{{ token }}</td>
                    {%- endfor -%}
                </tr>
                <tr>
                    <td class="row-title">Truth</td>
                    {%- for truth, prediction in sentence.labels -%}
                    <td class={{ "mismatch" if truth != prediction }}>{{ truth }}</td>
                    {%- endfor -%}
                </tr>
                <tr>
                    <td class="row-title">Prediction</td>
                    {%- for truth, prediction in sentence.labels -%}
                    <td class={{ "mismatch" if truth != prediction }}>{{ prediction }}</td>
                    {%- endfor -%}
                </tr>
                <tr>
                    <td class="row-title">Score</td>
                    {%- for score in sentence.scores -%}
                    <td class={{ "low-score" if score < 0.6 }}>{{ '%.1f'|format(100 * score) }}%</td>
                    {%- endfor -%}
                </tr>
            </table>
        </div>
        {%- endfor -%}
    </body>
</html>