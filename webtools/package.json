{
	"name": "Ingredient Parser Web Tool",
	"version": "1.0.0",
	"description": "Web tool for Ingredient Parser from @strangetom",
	"main": "index.tsx",
	"private": true,
	"dependencies": {
		"@mantine/core": "^8.3.13",
		"@mantine/dropzone": "^8.3.13",
		"@mantine/hooks": "^8.3.13",
		"@mantine/notifications": "^8.3.13",
		"@tabler/icons-react": "^3.36.1",
		"@types/react": "^19.2.9",
		"@types/react-dom": "^19.2.3",
		"ci": "^2.3.0",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"react-router-dom": "^7.13.0",
		"react-virtualized": "^9.22.6",
		"socket.io-client": "^4.8.3",
		"zustand": "^5.0.10"
	},
	"scripts": {
		"dev": "npm run watch & P1=$! & npm run flask & P2=$! & npm run sockets & P3=$! wait $P1 $P2 $P3 2>&1",
		"watch": "vite build --watch",
		"flask": "python3_path=$(which python3) && \"$python3_path\" app.py",
		"sockets": "python3_path=$(which python3) && \"$python3_path\" app.sockets.py"
	},
	"overrides": {
		"vite": {
			"rollup": "npm:@rollup/wasm-node"
		}
	},
	"resolutions": {
		"rollup": "npm:@rollup/wasm-node"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.13",
		"@svgr/core": "^8.1.0",
		"@svgr/plugin-jsx": "^8.1.0",
		"@types/node": "^25.0.10",
		"@types/react": "^18.2.55",
		"@types/react-dom": "^18.2.19",
		"@types/react-virtualized": "^9.22.3",
		"@vitejs/plugin-react": "^5.1.2",
		"postcss": "^8.5.6",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vite-plugin-html": "^3.2.2",
		"vite-tsconfig-paths": "^6.0.5"
	}
}
