{
	"name": "Ingredient Parser Web Tool",
	"version": "1.0.0",
	"description": "Web tool for Ingredient Parser from @strangetom",
	"main": "index.tsx",
	"private": true,
	"dependencies": {
		"@mantine/core": "^9.8.2",
		"@mantine/dropzone": "^9.8.2",
		"@mantine/hooks": "^9.8.2",
		"@mantine/notifications": "^9.8.2",
		"@tabler/icons-react": "^3.52.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"ci": "^2.3.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router-dom": "^7.18.6",
		"react-virtualized": "^10.0.1",
		"react-virtualized-auto-sizer": "^2.0.4",
		"socket.io-client": "^4.8.4",
		"zustand": "^5.1.0"
	},
	"scripts": {
		"dev": "npm run watch & P1=$! & npm run flask & P2=$! & npm run sockets & P3=$! wait $P1 $P2 $P3 2>&1",
		"watch": "vite build --watch",
		"flask": "python3_path=$(which python3) && \"$python3_path\" app.py",
		"sockets": "python3_path=$(which python3) && \"$python3_path\" app.sockets.py"
	},
	"overrides": {
		"vite": {
			"rollup": "npm:@rollup/wasm-node"
		}
	},
	"resolutions": {
		"rollup": "npm:@rollup/wasm-node"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@svgr/core": "^8.1.0",
		"@svgr/plugin-jsx": "^8.1.0",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/react-virtualized": "^9.22.4",
		"@vitejs/plugin-react": "^6.3.0",
		"postcss": "^8.5.33",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vite-plugin-html": "^3.2.2",
		"vite-tsconfig-paths": "^6.1.1"
	}
}
